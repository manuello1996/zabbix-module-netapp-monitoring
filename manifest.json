{
  "manifest_version": 2.0,
  "id": "netapp_monitoring",
  "type": "module",
  "name": "NetApp Monitoring",
  "namespace": "NetAppMonitoring",
  "version": "1.1.0",
  "author": "Manuel Pesenti",
  "description": "Cluster health, capacity, performance and discovered hardware for NetApp AFF A700 HTTP monitoring.",
  "actions": {
    "netapp.monitoring.list": {
      "class": "CControllerNetAppList",
      "view": "netapp.monitoring.list",
      "layout": "layout.htmlpage"
    },
    "netapp.monitoring.list.data": {
      "class": "CControllerNetAppListData",
      "view": "netapp.monitoring.list.content",
      "layout": "layout.json"
    },
    "netapp.monitoring.search": {
      "class": "CControllerNetAppSearch",
      "view": "netapp.monitoring.view",
      "layout": "layout.json"
    },
    "netapp.monitoring.view": {
      "class": "CControllerNetAppView",
      "view": "netapp.monitoring.view",
      "layout": "layout.htmlpage"
    }
  },
  "assets": {"css": ["common.css", "components.css", "blue-theme.css", "dark-theme.css"], "js": ["common.js", "components.js", "search.js", "list.js", "metrics.js", "menus.js", "locations.js", "problems.js", "resources.js"]}
}
